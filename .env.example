# Copia este fichero a .env y ajusta lo que necesites.
# Todos los valores tienen defecto en docker-compose.yml, así que .env es
# opcional en desarrollo. En producción, cambia TODAS las contraseñas.

# --- Postgres (verdad canónica) --------------------------------------------
POSTGRES_USER=sinapsis
POSTGRES_PASSWORD=sinapsis
POSTGRES_DB=sinapsis
POSTGRES_PORT=5432

# --- Neo4j (proyección de grafo) -------------------------------------------
NEO4J_USER=neo4j
NEO4J_PASSWORD=sinapsis-dev
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
# Súbelo en máquinas con memoria de sobra; 1G va justo para el grafo completo.
NEO4J_HEAP=1G

# --- Redis (cola e ingesta) ------------------------------------------------
REDIS_PORT=6379

# --- API -------------------------------------------------------------------
API_PORT=8080
